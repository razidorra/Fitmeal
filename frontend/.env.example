VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_API_PROXY_TARGET=http://localhost:4000

# Only needed for a production build against a separately hosted API (see docs/DEPLOYMENT.md).
# Leave unset for local dev — VITE_API_PROXY_TARGET above handles that instead.
# VITE_API_URL=https://fitmeal-api.onrender.com/api

# Only needed when the frontend is hosted below the domain root (for example GitHub Pages).
# The deployment workflow sets this automatically from the repository name.
# VITE_BASE_PATH=/your-repository-name/
