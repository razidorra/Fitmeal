PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Comma-separated browser origins allowed to call the API in production.
# CORS_ORIGINS=https://your-site.example,https://razidorra.github.io
CORS_ORIGINS=

# FitMeal AI assistant — free API key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
